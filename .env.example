# Local development defaults only. Compose binds published ports to loopback.
POSTGRES_USER=pinmorph
POSTGRES_PASSWORD=pinmorph-local
POSTGRES_DB=pinmorph
POSTGRES_PORT=15432
REDIS_PORT=16379
MINIO_ROOT_USER=pinmorph
MINIO_ROOT_PASSWORD=pinmorph-local-storage
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
API_PORT=8000
WEB_PORT=8080

# Host-run Python commands use these addresses. Compose supplies internal addresses.
DATABASE_URL=postgresql+psycopg://pinmorph:pinmorph-local@127.0.0.1:15432/pinmorph
REDIS_URL=redis://127.0.0.1:16379/0
S3_ENDPOINT_URL=http://127.0.0.1:9000
S3_ACCESS_KEY=pinmorph
S3_SECRET_KEY=pinmorph-local-storage
S3_BUCKET=pinmorph-media
LOG_LEVEL=INFO
# Defaults to the versioned 50/50 recency/popularity configuration. Core exercises are pending.
# FEED_CONFIG={"version":"feed:recency:v2","experiment":{"arms":[{"name":"recency","buckets":10000,"ranker":"ranker:recency:v1"}]}}
SIM_MODE=false
# Simulator controls require the generated disposable setup (docs/PHASE3B.md).
# SIM_DISPOSABLE=true
# SIM_ENVIRONMENT_ID=pinmorph-sim-lab
# SIM_CONTROL_TOKEN=<private token with at least 32 characters>
# For HTTPS deployments set COOKIE_SECURE=true. Custom web origins must be explicit.
COOKIE_SECURE=false
TRUSTED_ORIGINS=["http://localhost:8080","http://127.0.0.1:8080","http://localhost:5173","http://127.0.0.1:5173"]
